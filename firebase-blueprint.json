{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role-based identity",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "email", "role"]
    },
    "EmergencySession": {
      "title": "Emergency Session",
      "description": "Active clinical distress signal and video session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "resolved", "escalated"] },
        "urgency": { "type": "string", "enum": ["critical", "high"] },
        "timestamp": { "type": "object" },
        "vitals": {
          "type": "object",
          "properties": {
            "bp": { "type": "string" },
            "hr": { "type": "string" },
            "spo2": { "type": "string" }
          }
        },
        "clinicalNotes": { "type": "string" },
        "doctorName": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      },
      "required": ["patientId", "patientName", "status", "urgency", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "emergencySessions/{id}": {
      "schema": "EmergencySession",
      "description": "Active emergency sessions"
    }
  }
}
